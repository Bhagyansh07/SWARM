{
  "name": "swarm-backend",
  "version": "1.0.0",
  "description": "SWARM backend — Express + serverless orchestrator for the AI agent swarm",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^4.21.1",
    "groq-sdk": "^1.6.0",
    "openai": "^7.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}

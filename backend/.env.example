# SWARM backend configuration — copy this file to `.env` and fill in what you have.
# A Groq key is optional: with no key (or AI_PROVIDER=simulation) SWARM runs the
# deterministic simulator and the UI works exactly the same.

# HTTP
PORT=8080
CORS_ORIGIN=http://localhost:3000

# AI provider — Groq free tier
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto
COST_PER_MILLION_TOKENS_USD=0.59

# Storage — missions are JSON documents.
# Local dev default: a folder on disk (no config needed).
# SWARM_DATA_DIR=./.swarm-data
# Production (Vercel): set the blob store token to persist to Vercel Blob.
# The Vercel Blob integration injects BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
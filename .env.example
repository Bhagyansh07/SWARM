# SWARM environment template (monorepo root).
#
# The backend reads its configuration from `backend/.env` (copy
# `backend/.env.example` there). This file documents the full set of variables
# for convenience.
#
# AI provider (optional). Get a key at https://console.groq.com/keys
# With no key, SWARM runs the deterministic simulator and the UI is identical.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto

# Backend HTTP
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Storage (optional). Defaults to a local folder in dev.
# SWARM_DATA_DIR=./.swarm-data
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Share-link signing key (set in production).
# SHARE_SECRET=

# Frontend (optional). Point the web app at a non-default API URL.
# BACKEND_URL=http://localhost:8080

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================================
   SWARM DESIGN SYSTEM — EXECUTIVE SAAS SPECIFICATION
   High-precision, non-AI bespoke design language.
   Obsidian Titanium dark foundation + Crisp Luminous light counterpart.
   ========================================================================== */

:root {
  color-scheme: dark;

  /* Geometry & Radii */
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;

  /* Motion Curves (Mass & Spring physics) */
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --fast: 150ms;
  --base: 240ms;
  --slow: 400ms;

  /* Z-index scale */
  --z-base: 1;
  --z-elevated: 10;
  --z-sticky: 40;
  --z-topbar: 50;
  --z-overlay: 70;
  --z-modal: 80;
  --z-toast: 90;

  /* ---- DARK THEME (Titanium & Obsidian Slate) ---- */
  --paper: #080a0f;
  --paper-2: #0d111a;
  --paper-3: #121824;
  --paper-4: #182030;
  --field: #0a0d14;

  --line: rgba(255, 255, 255, 0.08);
  --line-strong: rgba(255, 255, 255, 0.16);
  --line-subtle: rgba(255, 255, 255, 0.04);

  --ink: #f8fafc;
  --dim: #94a3b8;
  --faint: #64748b;

  /* Primary Signal: Electric Cyan / Hyper-Cobalt */
  --signal: #00d2ff;
  --signal-glow: rgba(0, 210, 255, 0.28);
  --signal-dim: rgba(0, 210, 255, 0.12);
  --signal-line: rgba(0, 210, 255, 0.35);
  --on-signal: #05131d;

  /* Status Accents */
  --ok: #10b981;
  --ok-dim: rgba(16, 185, 129, 0.14);
  --warn: #f59e0b;
  --warn-dim: rgba(245, 158, 11, 0.14);
  --bad: #ef4444;
  --bad-dim: rgba(239, 68, 68, 0.14);

  /* Agent Identity Signatures */
  --agent-kai: #10b981;
  --agent-lyra: #818cf8;
  --agent-vex: #f59e0b;
  --agent-nova: #38bdf8;

  /* Surface Shadows & Lighting */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
  --shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.6), 0 0 1px 1px rgba(255, 255, 255, 0.05);
  --shadow-lg: 0 12px 36px -4px rgba(0, 0, 0, 0.8), 0 0 1px 1px rgba(255, 255, 255, 0.08);
  --shadow-glow: 0 0 24px -4px var(--signal-glow);

  --grid-line: rgba(255, 255, 255, 0.035);
  --scrollbar: rgba(255, 255, 255, 0.15);
  --overlay: rgba(4, 6, 10, 0.82);
  --grid: linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
}

[data-theme='light'] {
  color-scheme: light;

  --paper: #f8fafc;
  --paper-2: #ffffff;
  --paper-3: #f1f5f9;
  --paper-4: #e2e8f0;
  --field: #ffffff;

  --line: rgba(15, 23, 42, 0.08);
  --line-strong: rgba(15, 23, 42, 0.16);
  --line-subtle: rgba(15, 23, 42, 0.04);

  --ink: #0f172a;
  --dim: #475569;
  --faint: #94a3b8;

  --signal: #0284c7;
  --signal-glow: rgba(2, 132, 199, 0.22);
  --signal-dim: rgba(2, 132, 199, 0.09);
  --signal-line: rgba(2, 132, 199, 0.28);
  --on-signal: #ffffff;

  --ok: #059669;
  --ok-dim: rgba(5, 150, 105, 0.1);
  --warn: #d97706;
  --warn-dim: rgba(217, 119, 6, 0.1);
  --bad: #dc2626;
  --bad-dim: rgba(220, 38, 38, 0.1);

  --agent-kai: #059669;
  --agent-lyra: #6366f1;
  --agent-vex: #d97706;
  --agent-nova: #0284c7;

  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
  --shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.08), 0 0 1px rgba(15, 23, 42, 0.1);
  --shadow-lg: 0 16px 36px -6px rgba(15, 23, 42, 0.12), 0 0 1px rgba(15, 23, 42, 0.12);
  --shadow-glow: 0 0 20px -2px var(--signal-glow);

  --grid-line: rgba(15, 23, 42, 0.035);
  --scrollbar: rgba(15, 23, 42, 0.18);
  --overlay: rgba(15, 23, 42, 0.5);
}

/* Base Styles */
* {
  box-sizing: border-box;
}

html {
  font-family: var(--font-display), system-ui, -apple-system, sans-serif;
  background: var(--paper);
  color: var(--ink);
  font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
  -webkit-text-size-adjust: 100%;
}

@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}

body {
  margin: 0;
  min-height: 100vh;
  background-color: var(--paper);
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Background Atmosphere */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(0, 210, 255, 0.07), transparent 60%),
    radial-gradient(ellipse 60% 40% at 90% 20%, rgba(129, 140, 248, 0.05), transparent 50%),
    radial-gradient(ellipse 50% 30% at 10% 40%, rgba(16, 185, 129, 0.04), transparent 50%);
  z-index: 0;
}

::selection {
  background: var(--signal-dim);
  color: var(--signal);
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--scrollbar);
  border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--line-strong);
}
* {
  scrollbar-color: var(--scrollbar) transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--signal);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.font-display {
  font-family: var(--font-display), sans-serif;
}
.font-mono {
  font-family: var(--font-mono), monospace;
}

.bg-grid {
  background-image: var(--grid);
  background-size: 28px 28px;
}

/* High-End Micro-Aesthetics & Doppelrand (Double-Bezel) Cards */
.saas-card-shell {
  position: relative;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 4px;
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow);
  transition: border-color var(--base) var(--ease), box-shadow var(--base) var(--ease);
}
.saas-card-shell:hover {
  border-color: var(--line-strong);
  box-shadow: var(--shadow-lg);
}

.saas-card-inner {
  position: relative;
  background: var(--paper-2);
  border: 1px solid var(--line-subtle);
  border-radius: calc(var(--radius-lg) - 4px);
  overflow: hidden;
}

/* Backward-compatible Panel class with modern SaaS elevation */
.panel {
  position: relative;
  background: var(--paper-2);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
}
.panel:hover {
  border-color: var(--line-strong);
}

.panel-head {
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.015);
  backdrop-filter: blur(8px);
}

.rack-index {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--faint);
  font-weight: 500;
}

/* LED Indicator / Live Beacon */
.led {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  flex: none;
  position: relative;
}
.led-live {
  animation: pulse-beacon 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
.led-live::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 9999px;
  background: inherit;
  opacity: 0.35;
  animation: ping-beacon 2s cubic-bezier(0, 0, 0.2, 1) infinite;
}

@keyframes pulse-beacon {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.75; transform: scale(0.92); }
}

@keyframes ping-beacon {
  0% { transform: scale(1); opacity: 0.6; }
  75%, 100% { transform: scale(2.2); opacity: 0; }
}

/* Master Buttons */
.key {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 13px;
  border-radius: var(--radius-full);
  border: 1px solid var(--signal-line);
  background: linear-gradient(180deg, var(--signal) 0%, rgba(0, 180, 230, 0.92) 100%);
  color: var(--on-signal);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.35), var(--shadow-glow);
  cursor: pointer;
  transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease), filter var(--fast) var(--ease);
  user-select: none;
}
.key:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
  box-shadow: 0 4px 14px 0 var(--signal-glow), inset 0 1px 1px rgba(255, 255, 255, 0.45);
}
.key:active {
  transform: translateY(1px) scale(0.98);
}
.key:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 13px;
  border-radius: var(--radius-full);
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.03);
  color: var(--ink);
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: background var(--fast) var(--ease), border-color var(--fast) var(--ease), color var(--fast) var(--ease);
}
.ghost:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--line-strong);
  color: var(--ink);
}
.ghost:active {
  transform: scale(0.98);
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: var(--radius-full);
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.03);
  color: var(--dim);
  cursor: pointer;
  transition: all var(--fast) var(--ease);
}
.btn-icon:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--line-strong);
  color: var(--ink);
}

/* Fields & Inputs */
.field {
  background: var(--field);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  color: var(--ink);
  transition: border-color var(--fast) var(--ease), box-shadow var(--fast) var(--ease);
}
.field:focus {
  border-color: var(--signal);
  box-shadow: 0 0 0 3px var(--signal-dim);
}

/* Modern Pill Segmented Controls */
.segmented {
  display: inline-flex;
  align-items: center;
  padding: 3px;
  gap: 2px;
  background: var(--paper-3);
  border: 1px solid var(--line);
  border-radius: var(--radius-full);
}
.segmented button {
  border: 0;
  background: transparent;
  color: var(--dim);
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 500;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all var(--fast) var(--ease);
}
.segmented button:hover {
  color: var(--ink);
}
.segmented button[aria-selected='true'],
.segmented button[aria-checked='true'] {
  background: var(--paper-2);
  color: var(--ink);
  box-shadow: var(--shadow-sm);
}

/* Modern Chip / Badge */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  color: var(--dim);
}

/* Telemetry Readout */
.readout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
}
.readout-label {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--faint);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.readout-value {
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* Keyboard badge */
.kbd {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 6px;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 500;
  border-radius: var(--radius-xs);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--line);
  color: var(--dim);
  line-height: 1;
}

/* Launcher Preset Card */
.patch-row {
  position: relative;
  display: block;
  width: 100%;
  cursor: pointer;
  text-align: left;
  border: 1px solid var(--line);
  background: var(--paper-2);
  border-radius: var(--radius);
  transition: all var(--fast) var(--ease);
}
.patch-row:hover {
  border-color: var(--line-strong);
  background: var(--paper-3);
  transform: translateY(-1px);
}
.patch-row.active {
  border-color: var(--signal);
  background: var(--signal-dim);
  box-shadow: 0 0 16px -2px var(--signal-dim);
}

/* SVG Line & Motion Graphics animations */
@keyframes dash-flow {
  to {
    stroke-dashoffset: -40;
  }
}
.flow-line {
  stroke-dasharray: 6 6;
  animation: dash-flow 1.5s linear infinite;
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.animate-spin-slow {
  animation: spin-slow 24s linear infinite;
}

/* Motion Text Shimmer */
.motion-text-gradient {
  background: linear-gradient(135deg, #ffffff 20%, #00d2ff 70%, #818cf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
[data-theme='light'] .motion-text-gradient {
  background: linear-gradient(135deg, #0f172a 20%, #0284c7 70%, #4338ca 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Micro-animations */
.fade-up {
  animation: fadeUp 0.6s var(--ease) both;
}
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
